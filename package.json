{
  "name": "cortex",
  "version": "0.1.0",
  "description": "A local-first CLI coding agent — works with local (Ollama) and cloud LLM providers.",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx apps/cli/src/index.ts",
    "typecheck": "tsc --build",
    "build": "npm run build -w @cortex/cli",
    "test": "vitest run",
    "test:packages": "npm test --workspaces --if-present",
    "test:e2e": "npm run test:e2e:agent && npm run test:e2e:cli && npm run test:e2e:context",
    "test:e2e:agent": "tsx tests/e2e-agent-test.ts",
    "test:e2e:cli": "tsx tests/e2e-cli-test.ts",
    "test:e2e:context": "tsx tests/e2e-context-test.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^5.0.1"
  }
}
