# Only needed for cloud providers. Ollama (the default) needs neither.
# Anthropic API key for accessing Claude models (if used)
ANTHROPIC_API_KEY=
# Groq API key for accessing Groq models (if used)
GROQ_API_KEY=

# Optional overrides
# Base URL for the Ollama server (defaults to http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
# Model name to request from Ollama (e.g., llama3.1)
OLLAMA_MODEL=llama3.1
# Base URL for Groq API (defaults to https://api.groq.com/openai/v1)
GROQ_BASE_URL=https://api.groq.com/openai/v1
