# Cortex configuration. Copy to .env (which is gitignored) and fill in what you use.
# Real environment variables always win over this file.

# Which provider to use: ollama | groq | anthropic.
# Leave empty to auto-pick: Groq if GROQ_API_KEY is set, otherwise Ollama.
# Anthropic is never picked automatically; set it here to opt in.
CORTEX_PROVIDER=

# --- Ollama (local, needs no key) ---
# Model to request (e.g. llama3.1). Required when Ollama is the provider.
OLLAMA_MODEL=llama3.1
# Defaults to http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# --- Groq (cloud) ---
GROQ_API_KEY=
# Required when Groq is the provider.
GROQ_MODEL=
# Defaults to https://api.groq.com/openai/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Anthropic (cloud, opt-in via CORTEX_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
# Required when Anthropic is the provider.
ANTHROPIC_MODEL=
# Defaults to https://api.anthropic.com
ANTHROPIC_BASE_URL=https://api.anthropic.com
