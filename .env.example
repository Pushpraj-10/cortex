# Cortex configuration. Copy to .env (which is gitignored) and fill in what you use.
# Real environment variables always win over this file.
# You can also skip all of this: run cortex and type /provider to enter a key and model
# (saved to ~/.cortex/credentials.json). Variables set here or in your shell override that.

# Which provider to use: ollama | google | anthropic.
# Leave empty to use Ollama. The cloud providers are never picked automatically
# (an API key exported for other tools must not start sending your code to a cloud);
# set this explicitly to opt in.
CORTEX_PROVIDER=

# --- Ollama (local, needs no key) ---
# Model to request (e.g. llama3.1). Required when Ollama is the provider.
OLLAMA_MODEL=llama3.1
# Defaults to http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# --- Google Gemini (cloud, opt-in via CORTEX_PROVIDER=google) ---
GOOGLE_API_KEY=
# Required when Google is the provider (e.g. gemini-2.0-flash).
GOOGLE_MODEL=
# Defaults to https://generativelanguage.googleapis.com
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com

# --- Anthropic (cloud, opt-in via CORTEX_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
# Required when Anthropic is the provider.
ANTHROPIC_MODEL=
# Defaults to https://api.anthropic.com
ANTHROPIC_BASE_URL=https://api.anthropic.com
